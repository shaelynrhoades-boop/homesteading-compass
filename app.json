{
  "expo": {
    "name": "homesteading-compass",
    "slug": "homesteading-compass",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "yourapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow access to select screenshots and photos for support messages.",
        "NSLocationWhenInUseUsageDescription": "Allow location access to fetch local weather forecasts."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.homesteadingcompass"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-image-picker",
      "expo-location",
      "expo-notifications"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a1df0193-f855-48c5-86be-a85ce603aca6"
      }
    }
  }
}
